    },
    "gte-modern-colbert": {
      "repo_id": "lightonai/GTE-ModernColBERT-v1",
      "revision": "cbbe53366e564450558f5e639dd499171f127538",
      "license": "apache-2.0",
      "role": "late-interaction"
    },
    "qwen3-reward": {
      "repo_id": "Qwen/Qwen3-0.6B",
      "revision": "c1899de289a04d12100db370d81485cdf75e47ca",
      "license": "apache-2.0",
      "role": "outcome-and-process-reward-backbone",
      "head": "randomly-initialized-scalar-sequence-classification"
    }
  },
  "datasets": {
    "msmarco-triples": {
      "repo_id": "sentence-transformers/msmarco-msmarco-MiniLM-L6-v3",
      "revision": "0d54352548089199bde15ad7e06efe895dc80b56",
      "license": "hub-card-unspecified"
    },
    "nanobeir-msmarco": {
      "repo_id": "sentence-transformers/NanoBEIR-en",
      "revision": "beb106fbcfaa599c508c667041bf8c85fd78736b",
      "subset": "NanoMSMARCO",
      "license": "hub-card-unspecified"
    },
    "natural-questions-train-pairs": {
      "repo_id": "sentence-transformers/natural-questions",
      "revision": "f9e894e1081e206e577b4eaa9ee6de2b06ae6f17",
      "subset": "pair",
      "split": "train",
      "license": "hub-card-unspecified",
      "source_license": "cc-by-sa-3.0"
    },
    "natural-questions-retrieval": {
      "repo_id": "mteb/nq",
      "revision": "b84726e65fd226125cf7c0cbeeb5c214d49e8187",
      "subsets": ["default", "corpus", "queries"],
      "split": "test",
      "license": "cc-by-nc-sa-3.0"
    },
    "miracl-topics-qrels": {
      "repo_id": "miracl/miracl",
      "revision": "5be20db9509754dadad47689368639fcec739c00",
      "languages": ["ar", "en", "hi", "ja"],
      "splits": ["train", "dev"],
      "license": "apache-2.0"
    },
    "miracl-corpus": {
      "repo_id": "miracl/miracl-corpus",
      "revision": "d921ec7e349ce0d28daf30b2da9da5ee698bef0d",
      "languages": ["ar", "en", "hi", "ja"],
      "license": "apache-2.0"
    },
    "stsb-v2": {
      "repo_id": "mteb/STSBenchmarkv2",
      "revision": "93b628c3969a75e76727db2b7ee252e53e96268d",
      "license": "unknown"
    },
    "sick-r": {
      "repo_id": "mteb/sickr-sts",
      "revision": "20a6d6f312dd54037fe07a32d58e5e168867909d",
      "license": "cc-by-nc-sa-3.0"
    },
    "sprint-duplicate": {
      "repo_id": "mteb/sprintduplicatequestions-pairclassification",
      "revision": "d66bd1f72af766a5cc4b0ca5e00c162f89e8cc46",
      "license": "unknown"
    },
    "trec-dl-2019": {
      "source": "ir_datasets",
      "source_version": "0.5.11",
      "dataset_id": "msmarco-passage/trec-dl-2019/judged",
      "license": "msmarco-and-trec-terms"
    },
    "ultrafeedback": {
      "repo_id": "trl-lib/ultrafeedback_binarized",
      "revision": "47124cb5778f5d50de1c7676a412828f3ea7c555",
      "license": "hub-card-unspecified"
    },
    "math-shepherd": {
      "repo_id": "trl-lib/math_shepherd",
      "revision": "004d0e7dc9249b4af58ce41e58b7d2fef184dade",
      "license": "hub-card-unspecified"
    }
  },
  "references": {
    "sentence-transformers": "5.6.1",
    "pylate": "1.6.0",
    "trl": "1.10.0"
  },
  "workloads": [
    {
      "name": "dense-realistic",
      "model": "mpnet-base",
      "train": ["msmarco-triples"],
      "evaluate": ["nanobeir-msmarco"],
      "reference": "sentence-transformers"
    },
    {
      "name": "dense-natural-questions",
      "model": "mpnet-base",
      "train": ["natural-questions-train-pairs"],
      "evaluate": ["natural-questions-retrieval"],
      "metrics": ["recall@10", "recall@100"],
      "reference": "sentence-transformers"
    },
    {
      "name": "dense-multilingual",
      "model": "jina-v5-small",
      "train": ["miracl-topics-qrels", "miracl-corpus"],
      "evaluate": ["miracl-topics-qrels", "miracl-corpus"],
      "languages": ["ar", "en", "hi", "ja"],
      "metrics": ["ndcg@10", "recall@100"],
      "report_each_language": true,
      "reference": "sentence-transformers"
    },
    {
      "name": "semantic-similarity",
      "model": "mpnet-base",
      "architecture_control": "bert-base",
      "train": ["stsb-v2"],
      "evaluate": ["stsb-v2", "sick-r"],
      "reference": "sentence-transformers"
    },
    {
      "name": "pair-classification",
      "model": "mpnet-base",
      "architecture_control": "bert-base",
      "train": ["sprint-duplicate"],
      "evaluate": ["sprint-duplicate"],
      "reference": "sentence-transformers"
    },
    {
      "name": "cross-encoder-reranking",
      "model": "minilm-cross-encoder",
      "train": ["msmarco-triples"],
      "evaluate": ["trec-dl-2019"],
      "reference": "sentence-transformers"
    },
    {
      "name": "late-interaction",
      "model": "gte-modern-colbert",
      "train": ["msmarco-triples"],
      "evaluate": ["nanobeir-msmarco"],
      "reference": "pylate"
    },
    {
      "name": "pairwise-outcome-reward",
      "model": "qwen3-reward",
      "train": ["ultrafeedback"],
      "evaluate": ["ultrafeedback"],
      "objective": "bradley-terry-log-sigmoid",
      "reference": "trl"
    },
    {
      "name": "process-reward",
      "model": "qwen3-reward",
      "train": ["math-shepherd"],
      "evaluate": ["math-shepherd"],
      "objective": "stepwise-binary-cross-entropy",
      "reference": "trl"
    }
  ]
}
